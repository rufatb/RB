[Unit]
Description=Stage the intraday history cache well before the open

# 08:05, not 09:4x, and BEFORE rb-biotech at 08:10 — that unit's preflight
# step checks the cache this one stages, so staging it after would report
# NOT READY every morning on a cache that was about to be fine. bar_cache refuses to run at or after 09:30 (it stages the
# PRIOR session's bars, so running it into the open would be meaningless), and
# staging it early leaves the 09:46 acquisition budget for live quotes only.
[Timer]
OnCalendar=Mon..Fri *-*-* 08:05:00 America/New_York
AccuracySec=30s
Persistent=false
Unit=rb-prepare.service

[Install]
WantedBy=timers.target
