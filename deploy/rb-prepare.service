[Unit]
Description=RB pre-open intraday history cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rb-report
Group=rb-report
UMask=0077
NoNewPrivileges=true
WorkingDirectory=/opt/RB
EnvironmentFile=/etc/rb-report.env

# Own cache preparation independently of biotech. The Gmail sender's saved
# September 10 cache was complete at 08:13 and its preflight said READY; that
# timeout cannot be attributed to an absent cache from a unit-file inspection.
# Preparation success does not establish live endpoint access at 09:46.
ExecStart=/opt/RB/.venv/bin/python bar_cache.py --directory ${RB_INTRADAY_CACHE_DIR}
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
