# Copy to /etc/rb-report.env, mode 0600. Values are examples, not credentials.
RB_STATE_DIR=/var/lib/rb-report
RB_SMTP_HOST=smtp.gmail.com
RB_SMTP_USER=your-account@example.com
RB_SMTP_PASSWORD=replace-with-application-password
RB_REPORT_TO=your-account@example.com
RB_BIOTECH_SNAPSHOT_JSON=/var/lib/rb-report/biotech_snapshot.json
RB_BIOTECH_EVENTS_JSON=/var/lib/rb-report/biotech_events.json
RB_INTRADAY_CACHE_DIR=/var/lib/rb-report/intraday_cache
RB_REFERENCE_CLOSES_JSON=/var/lib/rb-report/reference_closes.json
# Day-99 staged DeepSeek factor layer (shadow research; preparation only).
# The CREDENTIAL does not belong here — put it in
# ${RB_STATE_DIR}/secrets/deepseek_api_key, mode 0600, owned by rb-report.
# The MODEL does: the code default is deepseek-chat, and the 2026-09-12 account
# check found that identifier absent while deepseek-flash was present. There is
# no automatic fallback, so an unset model fails preparation every morning.
# DEEPSEEK_MODEL=deepseek-flash
# Optional timestamped external market-data publisher (not last-trade-only):
# RB_QUOTES_JSON=/var/lib/rb-report/live_quotes.json
# RB_SEC_USER_AGENT=RB-research/1.0 your-contact@example.com
