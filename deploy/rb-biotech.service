[Unit]
Description=RB pre-open biotech universe preparation
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=rb-report
Group=rb-report
WorkingDirectory=/opt/RB
EnvironmentFile=/etc/rb-report.env
ExecStart=/opt/RB/.venv/bin/python build_biotech.py
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
