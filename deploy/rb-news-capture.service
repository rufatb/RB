[Unit]
Description=RB persistent News Desk source collection
After=network-online.target

[Service]
Type=oneshot
User=rb-report
Group=rb-report
UMask=0077
WorkingDirectory=/opt/RB
EnvironmentFile=/etc/rb-report.env
ExecStart=/opt/RB/.venv/bin/python /opt/RB/news_edition.py capture
TimeoutStartSec=75
