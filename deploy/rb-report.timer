[Unit]
Description=RB report preparation at 09:44; publication begins at 09:46

# Starting preparation at 09:44 leaves the 09:45 minute for options. The
# wrapper waits until 09:46 before equity/intraday acquisition. Independent
# 22s/10s budgets and a final clock check still apply. Late/outage reports are
# frozen informational publications; they are not missing session records.
#
# The wrapper checks imports and explicitly waits until 09:46 before invoking
# daily_job. Calling daily_job directly at 09:45 would raise and send nothing.
# This head start prepares the host; it does not acquire a future signal early
# or guarantee completion inside the window.
[Timer]
OnCalendar=Mon..Fri *-*-* 09:44:00 America/New_York
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=rb-report.service

[Install]
WantedBy=timers.target
