[Unit]
Description=RB event options refresh within the report freshness window
[Timer]
# A 09:43 observation is already older than 120 seconds at 09:46. Report
# preparation starts at 09:44 and waits; options refresh at 09:45, before
# equity/intraday acquisition at 09:46. Observation clocks are never refreshed
# by copying a snapshot. No two timers share a minute.
OnCalendar=Mon..Fri *-*-* 09:45:00 America/New_York
Persistent=false
AccuracySec=1s
[Install]
WantedBy=timers.target
