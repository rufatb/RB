__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
brief.log
.scan_state.json
.DS_Store

# transient run logs — these mutate on every run and are not history
.runlogs/

# large rebuildable data panels — regenerate with validate_events_build.py
daily.csv

# the twins price panel: a rolling 720-day window, so it changes on every
# rebuild and is a cache, not history. Regenerate with validate_twins.py.
# data/short_interest.csv is NOT here — it is an acquired feed whose issuer
# filtering is part of the record.
data/twins_panel.csv

# the US daily panel: 188MB and rebuildable in one command. Regenerate with
# build_us.py. data/us_earnings.csv is NOT here -- it is an acquired SEC feed
# whose Item 2.02 filtering and before-open/after-close timing are part of the
# record, and it is small.
data/us_daily.csv
data/us_daily_holdout.csv
data/us_hourly.csv
